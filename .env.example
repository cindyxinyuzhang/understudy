# Copy to .env for a non-Docker run. Docker Compose sets its own values and ignores
# this file; see docker-compose.yml.
#
# The defaults below are the dependency-free mode: SQLite, jobs executed inline, page
# images on local disk, synthetic OMR. Enough to run the whole app from a clone.

ENV=dev
LOG_LEVEL=INFO

# --- data ---
DATABASE_URL=sqlite+pysqlite:///./understudy.db
# Real setup:
# DATABASE_URL=postgresql+psycopg://understudy:understudy@localhost:5432/understudy

# --- jobs ---
# inline = run OMR in the request (no Redis needed, slow request, dev only)
# queue  = hand to Redis/RQ and run an `rq worker`
JOB_MODE=inline
REDIS_URL=redis://localhost:6379/0
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900

# --- object storage ---
# local = a directory served by the API (dev only)
# s3    = any S3-compatible endpoint: MinIO, Supabase Storage, AWS
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=understudy
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Set when objects are served from a CDN or public bucket instead of presigned URLs.
# S3_PUBLIC_BASE_URL=

# --- recognition ---
# fake  = deterministic synthetic score, no GPU, no model weights
# oemer = real OMR; needs the `omr` extra and realistically a GPU worker
OMR_ENGINE=fake

# --- auth ---
# With AUTH_DEV_MODE on, an `X-Dev-User: someone@example.com` header is accepted as
# identity. Startup refuses this combination when ENV=prod.
AUTH_DEV_MODE=true
SUPABASE_JWT_SECRET=dev-secret-not-for-prod
SUPABASE_JWT_AUDIENCE=authenticated

# --- misc ---
CORS_ORIGINS=["http://localhost:5173"]
# SENTRY_DSN=
